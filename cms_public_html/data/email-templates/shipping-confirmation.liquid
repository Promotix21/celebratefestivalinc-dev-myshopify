{# subject: Your order {{ order.name }} has shipped — {{ shop.name }} #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Your Order Has Shipped</title>
  <style>
    @media only screen and (max-width:620px){
      .email-wrapper{padding:12px !important;}
      .email-card{border-radius:0 !important;}
      .email-header{padding:20px 20px !important;}
      .email-body{padding:24px 20px !important;}
      .email-footer{padding:20px !important;}
      .item-img{display:none !important;}
      .col-half{display:block !important;width:100% !important;}
      .step-cell{width:18% !important;}
      .step-arrow{display:none !important;}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f0f4f8;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Order {{ order.name }} is on its way! Track your shipment inside.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table width="100%" cellpadding="0" cellspacing="0" class="email-wrapper" style="background:#f0f4f8;padding:30px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" class="email-card" style="max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);">

          <!-- HEADER -->
          <tr>
            <td class="email-header" style="background:#1a365d;padding:28px 32px;text-align:center;">
              {%- if shop.email_logo_url -%}
              <img src="{{ shop.email_logo_url }}" alt="{{ shop.name }}" width="160" style="max-width:160px;height:auto;display:block;margin:0 auto 12px;">
              {%- else -%}
              <div style="font-family:'Montserrat',Arial,sans-serif;font-size:22px;font-weight:800;color:#ffffff;letter-spacing:0.5px;margin:0 auto 8px;">CELEBRATE FESTIVAL INC</div>
              {%- endif -%}
              <div style="color:#94b8d8;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;">Restaurant Supply Specialists</div>
            </td>
          </tr>

          <!-- BODY -->

      <tr>
        <td style="background:linear-gradient(135deg,#1a365d 0%,#2d5a87 100%);padding:32px;text-align:center;">
          <h1 style="margin:0 0 8px;font-size:26px;font-weight:700;color:#ffffff;">Your order is on its way</h1>
          <p style="margin:0;font-size:15px;color:#bfdbfe;">We&apos;ve shipped your order and it&apos;s heading to you now.</p>
          {%- if fulfillment.tracking_url -%}
          <a href="{{ fulfillment.tracking_url }}" style="display:inline-block;margin-top:20px;padding:13px 28px;background:#ff6b6b;color:#fff;font-size:15px;font-weight:700;text-decoration:none;border-radius:6px;">Track Your Shipment</a>
          {%- endif -%}
        </td>
      </tr>
      <tr>
        <td style="padding:24px 32px 0;">
          <p style="margin:0 0 8px;font-size:15px;color:#475569;">Hi {{ order.shipping_address.first_name }},</p>
          <p style="margin:0;font-size:15px;color:#475569;line-height:1.6;">Great news — your order <strong>{{ order.name }}</strong> has been shipped and is on its way to you.</p>
        </td>
      </tr>
      {%- if fulfillment.tracking_number -%}
      <tr>
        <td style="padding:20px 32px 0;">
          <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:16px 20px;">
            <table width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td>
                  <div style="font-size:12px;font-weight:700;color:#166534;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Tracking Number</div>
                  <div style="font-size:18px;font-weight:700;color:#15803d;letter-spacing:1px;">{{ fulfillment.tracking_number }}</div>
                  {%- if fulfillment.tracking_company -%}<div style="font-size:13px;color:#166534;margin-top:2px;">via {{ fulfillment.tracking_company }}</div>{%- endif -%}
                </td>
                {%- if fulfillment.tracking_url -%}
                <td style="text-align:right;">
                  <a href="{{ fulfillment.tracking_url }}" style="display:inline-block;padding:10px 20px;background:#16a34a;color:#fff;font-size:13px;font-weight:700;text-decoration:none;border-radius:6px;">Track Package</a>
                </td>
                {%- endif -%}
              </tr>
            </table>
          </div>
        </td>
      </tr>
      {%- endif -%}

      <!-- SHIPPING TO (moved above item lines) -->
      <tr>
        <td style="padding:20px 32px 0;">
          <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;">
            <div style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Shipping To</div>
            <div style="font-size:14px;color:#1e293b;line-height:1.6;">
              {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}<br>
              {{ order.shipping_address.address1 }}<br>
              {%- if order.shipping_address.address2 != blank -%}{{ order.shipping_address.address2 }}<br>{%- endif -%}
              {{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}<br>
              {{ order.shipping_address.country }}
            </div>
          </div>
        </td>
      </tr>

      <!-- ITEMS SHIPPED -->
      <tr><td style="padding:24px 32px 4px;"><h3 style="margin:0;font-size:14px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;">Items Shipped</h3></td></tr>

      <tr>
        <td style="padding:12px 32px 0;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;">Product</td>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;text-align:center;width:50px;">Qty</td>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;text-align:right;width:80px;">Price</td>
            </tr>

            {%- for line in fulfillment.fulfillment_line_items -%}
            {%- assign item = line.line_item -%}
            <tr>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;vertical-align:top;">
                <table cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="item-img" style="width:64px;padding-right:12px;vertical-align:top;">
                      <img src="{{ item.image | img_url: '64x64' }}" width="64" height="64" alt="" style="border-radius:4px;border:1px solid #e2e8f0;">
                    </td>
                    <td style="vertical-align:top;">
                      <div style="font-size:14px;font-weight:600;color:#1e293b;">{{ item.title }}</div>
                      {%- if item.variant_title != 'Default Title' -%}
                      <div style="font-size:12px;color:#64748b;margin-top:2px;">{{ item.variant_title }}</div>
                      {%- endif -%}
                      {%- if item.sku != blank -%}
                      <div style="font-size:11px;color:#94a3b8;margin-top:2px;">SKU: {{ item.sku }}</div>
                      {%- endif -%}
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;text-align:center;font-size:14px;color:#475569;vertical-align:top;width:50px;">{{ line.quantity }}</td>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;text-align:right;font-size:14px;font-weight:600;color:#1a365d;vertical-align:top;width:80px;">{{ item.final_price | money }}</td>
            </tr>
            {%- endfor -%}
          </table>
        </td>
      </tr>

      <!-- SHIPPING POLICY — freight delivery inspection (ported from current template) -->
      <tr>
        <td style="padding:24px 32px 4px;">
          <h3 style="margin:0 0 14px;font-size:14px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;">When Your Delivery Arrives</h3>
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#fffbeb;border:1px solid rgba(212,175,55,0.35);border-radius:8px;">
            <tr>
              <td style="padding:18px 20px;">
                <div style="font-size:13px;color:#475569;line-height:1.7;margin-bottom:10px;">
                  Before the delivery driver leaves your driveway, please do the following:
                </div>
                <table cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td style="padding-bottom:8px;vertical-align:top;width:18px;">
                      <div style="width:18px;height:18px;background:#1a365d;border-radius:50%;text-align:center;line-height:18px;color:#fff;font-size:10px;font-weight:700;">1</div>
                    </td>
                    <td style="padding-bottom:8px;padding-left:10px;font-size:13px;color:#475569;line-height:1.6;">
                      <strong style="color:#0f172a;">Unpack</strong> everything. Keep all original packaging materials.
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:8px;vertical-align:top;">
                      <div style="width:18px;height:18px;background:#1a365d;border-radius:50%;text-align:center;line-height:18px;color:#fff;font-size:10px;font-weight:700;">2</div>
                    </td>
                    <td style="padding-bottom:8px;padding-left:10px;font-size:13px;color:#475569;line-height:1.6;">
                      <strong style="color:#0f172a;">Inspect</strong> the entire piece of equipment — top to bottom.
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom:8px;vertical-align:top;">
                      <div style="width:18px;height:18px;background:#1a365d;border-radius:50%;text-align:center;line-height:18px;color:#fff;font-size:10px;font-weight:700;">3</div>
                    </td>
                    <td style="padding-bottom:8px;padding-left:10px;font-size:13px;color:#475569;line-height:1.6;">
                      Make <strong style="color:#ff6b6b;">note</strong> of all damage you see. Take <strong style="color:#ff6b6b;">pictures</strong> if you can.
                    </td>
                  </tr>
                  <tr>
                    <td style="vertical-align:top;">
                      <div style="width:18px;height:18px;background:#1a365d;border-radius:50%;text-align:center;line-height:18px;color:#fff;font-size:10px;font-weight:700;">4</div>
                    </td>
                    <td style="padding-left:10px;font-size:13px;color:#475569;line-height:1.7;">
                      You have <strong style="color:#ff6b6b;">2 options:</strong><br>
                      &nbsp;&nbsp;&#8226; <strong style="color:#0f172a;">NO damage</strong> — Accept the shipment and sign off.<br>
                      &nbsp;&nbsp;&#8226; <strong style="color:#0f172a;">Slightly damaged</strong> — Accept but note damage on the acceptance form.<br>
                      &nbsp;&nbsp;&nbsp;&nbsp;<span style="color:#ff6b6b;font-weight:700;">REFUSE</span> only if the equipment is <strong>completely damaged</strong> beyond repair.
                    </td>
                  </tr>
                </table>
                <div style="margin-top:14px;padding:10px 14px;background:#ffffff;border-left:3px solid #ff6b6b;border-radius:0 6px 6px 0;font-size:12px;color:#475569;line-height:1.7;">
                  If freight damage occurs we are here to help. Call us at <strong style="color:#1a365d;">(408) 673-9999</strong> Monday–Friday, 8:30am–5:30pm Pacific Time.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr><td style="height:8px;line-height:8px;font-size:0;">&nbsp;</td></tr>

          <!-- FOOTER -->
          <tr>
            <td class="email-footer" style="background:#f8fafc;padding:24px 32px;border-top:1px solid #e2e8f0;text-align:center;">
              <p style="margin:0 0 8px;font-size:13px;color:#64748b;">
                <a href="{{ shop.url }}" style="color:#2d5a87;text-decoration:none;">{{ shop.name }}</a>
                &nbsp;·&nbsp; Fremont, CA &nbsp;·&nbsp;
                <a href="tel:4086739999" style="color:#2d5a87;text-decoration:none;">(408) 673-9999</a>
              </p>
              <p style="margin:0 0 8px;font-size:12px;color:#94a3b8;">
                You received this email because you placed an order or have an account at {{ shop.name }}.
              </p>
              <p style="margin:0;font-size:12px;color:#94a3b8;">
                &copy; {{ 'now' | date: '%Y' }} Celebrate Festival Inc. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
