{# subject: Your order {{ order.name }} is confirmed — {{ shop.name }} #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Order Confirmed</title>
  <style>
    @media only screen and (max-width:620px){
      .email-wrapper{padding:12px !important;}
      .email-card{border-radius:0 !important;}
      .email-header{padding:20px 20px !important;}
      .email-body{padding:24px 20px !important;}
      .email-footer{padding:20px !important;}
      .item-img{display:none !important;}
      .col-half{display:block !important;width:100% !important;}
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#f0f4f8;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">

  <!-- Preheader -->
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Your order {{ order.name }} has been received and is being processed.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>

  <table width="100%" cellpadding="0" cellspacing="0" class="email-wrapper" style="background:#f0f4f8;padding:30px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" class="email-card" style="max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.08);">

          <!-- HEADER -->
          <tr>
            <td class="email-header" style="background:#1a365d;padding:28px 32px;text-align:center;">
              <img src="https://celebratefestivalinc.com/cdn/shop/files/cf-logo-white.png" alt="Celebrate Festival Inc" width="160" style="max-width:160px;height:auto;display:block;margin:0 auto 12px;">
              <div style="color:#94b8d8;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;">Restaurant Supply Specialists</div>
            </td>
          </tr>

          <!-- BODY -->
          
      
      <tr>
        <td style="background:linear-gradient(135deg,#1a365d 0%,#2d5a87 100%);padding:32px;text-align:center;">
          <div style="font-size:48px;margin-bottom:12px;">🎉</div>
          <h1 style="margin:0 0 8px;font-size:26px;font-weight:700;color:#ffffff;">Order Confirmed!</h1>
          <p style="margin:0;font-size:15px;color:#bfdbfe;">Thank you — we&apos;ve received your order and it&apos;s being processed.</p>
          <a href="{{ order.customer_url }}" style="display:inline-block;margin-top:20px;padding:13px 28px;background:#ff6b6b;color:#fff;font-size:15px;font-weight:700;text-decoration:none;border-radius:6px;">Track Your Order</a>
        </td>
      </tr>
      <tr>
        <td style="padding:24px 32px 0;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="background:#eff6ff;border-left:4px solid #2d5a87;border-radius:4px;padding:14px 16px;">
                <table cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td>
                      <div style="font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:1px;font-weight:600;">Order Number</div>
                      <div style="font-size:22px;font-weight:700;color:#1a365d;">{{ order.name }}</div>
                    </td>
                    <td style="text-align:right;">
                      <div style="font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:1px;font-weight:600;">Date</div>
                      <div style="font-size:14px;font-weight:600;color:#475569;">{{ order.created_at | date: "%B %d, %Y" }}</div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr><td style="padding:20px 32px 4px;"><h3 style="margin:0;font-size:14px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;">Order Summary</h3></td></tr>
      
      <tr>
        <td style="padding:20px 32px 0;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;">Product</td>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;text-align:center;width:50px;">Qty</td>
              <td style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;padding-bottom:8px;border-bottom:2px solid #e2e8f0;text-align:right;width:80px;">Price</td>
            </tr>
            
            {%- for line_item in order.line_items -%}
            <tr>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;vertical-align:top;">
                <table cellpadding="0" cellspacing="0">
                  <tr>
                    <td class="item-img" style="width:64px;padding-right:12px;vertical-align:top;">
                      <img src="{{ line_item.image | img_url: '64x64' }}" width="64" height="64" alt="" style="border-radius:4px;border:1px solid #e2e8f0;">
                    </td>
                    <td style="vertical-align:top;">
                      <div style="font-size:14px;font-weight:600;color:#1e293b;">{{ line_item.title }}</div>
                      {%- if line_item.variant_title != 'Default Title' -%}
                      <div style="font-size:12px;color:#64748b;margin-top:2px;">{{ line_item.variant_title }}</div>
                      {%- endif -%}
                      {%- if line_item.sku != blank -%}
                      <div style="font-size:11px;color:#94a3b8;margin-top:2px;">SKU: {{ line_item.sku }}</div>
                      {%- endif -%}
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;text-align:center;vertical-align:top;font-size:14px;color:#475569;">{{ line_item.quantity }}</td>
              <td style="padding:12px 0;border-bottom:1px solid #f1f5f9;text-align:right;vertical-align:top;font-size:14px;font-weight:600;color:#1a365d;">{{ line_item.price | money }}</td>
            </tr>
            {%- endfor -%}
          </table>
        </td>
      </tr>
      
      <tr>
        <td style="padding:0 32px 24px;">
          <table width="100%" cellpadding="0" cellspacing="0">
            {%- if order.subtotal_price < order.total_price or order.shipping_price > 0 -%}
            <tr>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;">Subtotal</td>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;">{{ order.subtotal_price | money }}</td>
            </tr>
            {%- if order.shipping_price > 0 -%}
            <tr>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;">Shipping</td>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;">{{ order.shipping_price | money }}</td>
            </tr>
            {%- endif -%}
            {%- if order.shipping_price == 0 -%}
            <tr>
              <td style="font-size:14px;color:#10b981;padding:6px 0;border-bottom:1px solid #f1f5f9;">Shipping</td>
              <td style="font-size:14px;color:#10b981;font-weight:600;padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;">FREE</td>
            </tr>
            {%- endif -%}
            {%- for discount in order.discount_applications -%}
            <tr>
              <td style="font-size:14px;color:#10b981;padding:6px 0;border-bottom:1px solid #f1f5f9;">Discount ({{ discount.title }})</td>
              <td style="font-size:14px;color:#10b981;padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;">-{{ discount.total_allocated_amount | money }}</td>
            </tr>
            {%- endfor -%}
            {%- if order.tax_price > 0 -%}
            <tr>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;">Tax</td>
              <td style="font-size:14px;color:#475569;padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;">{{ order.tax_price | money }}</td>
            </tr>
            {%- endif -%}
            {%- endif -%}
            <tr>
              <td style="font-size:16px;font-weight:700;color:#1a365d;padding:10px 0 0;">Total</td>
              <td style="font-size:18px;font-weight:700;color:#1a365d;padding:10px 0 0;text-align:right;">{{ order.total_price | money }}</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr><td style="padding:0 32px 8px;"><h3 style="margin:0;font-size:14px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;">Delivery &amp; Payment</h3></td></tr>
      
      <tr>
        <td style="padding:0 32px 28px;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td class="col-half" style="width:48%;vertical-align:top;padding-right:16px;">
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;">
                  <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Shipping Address</div>
                  <div style="font-size:14px;color:#1e293b;line-height:1.6;">
                    {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}<br>
                    {{ order.shipping_address.address1 }}<br>
                    {%- if order.shipping_address.address2 != blank -%}{{ order.shipping_address.address2 }}<br>{%- endif -%}
                    {{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}<br>
                    {{ order.shipping_address.country }}
                  </div>
                </div>
              </td>
              <td class="col-half" style="width:48%;vertical-align:top;">
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:16px;">
                  <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Payment</div>
                  <div style="font-size:14px;color:#1e293b;line-height:1.6;">
                    {%- if order.payment_details.credit_card_company -%}
                    {{ order.payment_details.credit_card_company }}<br>ending in {{ order.payment_details.credit_card_last_four_digits }}
                    {%- else -%}
                    {{ order.financial_status | capitalize }}
                    {%- endif -%}
                  </div>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td style="padding:0 32px 28px;text-align:center;">
          <a href="{{ order.customer_url }}" style="display:inline-block;padding:13px 32px;background:#1a365d;color:#fff;font-size:14px;font-weight:700;text-decoration:none;border-radius:6px;">View Full Order Details</a>
        </td>
      </tr>

          <!-- FOOTER -->
          <tr>
            <td class="email-footer" style="background:#f8fafc;padding:24px 32px;border-top:1px solid #e2e8f0;text-align:center;">
              <p style="margin:0 0 8px;font-size:13px;color:#64748b;">
                <a href="{{ shop.url }}" style="color:#2d5a87;text-decoration:none;">{{ shop.name }}</a>
                &nbsp;·&nbsp; Fremont, CA &nbsp;·&nbsp;
                <a href="tel:4086739999" style="color:#2d5a87;text-decoration:none;">(408) 673-9999</a>
              </p>
              <p style="margin:0 0 8px;font-size:12px;color:#94a3b8;">
                You received this email because you placed an order or have an account at {{ shop.name }}.
              </p>
              <p style="margin:0;font-size:12px;color:#94a3b8;">
                &copy; {{ 'now' | date: '%Y' }} Celebrate Festival Inc. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>