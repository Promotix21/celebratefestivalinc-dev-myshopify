  <div class="rp-map-tooltip" id="{{ id }}-tooltip">
    <div class="rp-map-tooltip-state" id="{{ id }}-tooltip-state">State</div>
    <div class="rp-map-tooltip-stat" id="{{ id }}-tooltip-partners">0 Restaurant Partners</div>
    <div class="rp-map-tooltip-stat" id="{{ id }}-tooltip-locations">0 Supported Locations</div>
    <div class="rp-map-tooltip-tags" id="{{ id }}-tooltip-tags"></div>
  </div>
</div>

<script>
(function() {
  var mapId = '{{ id }}';
  var container = document.getElementById(mapId);
  if (!container) return;

  var tooltip = document.getElementById(mapId + '-tooltip');
  var tooltipState = document.getElementById(mapId + '-tooltip-state');
  var tooltipPartners = document.getElementById(mapId + '-tooltip-partners');
  var tooltipLocations = document.getElementById(mapId + '-tooltip-locations');
  var tooltipTags = document.getElementById(mapId + '-tooltip-tags');

  var activeStatesList = '{{ active_states }}'.split(',').map(function(s){ return s.trim(); });

  var mapData = {};
  try {
    var wrapper = container.closest('[data-partner]') || document.getElementById('rp-map-wrap');
    if (wrapper) {
      mapData = JSON.parse(wrapper.getAttribute('data-partner')) || {};
    }
  } catch(e) {}

  var paths = container.querySelectorAll('.states path');
  paths.forEach(function(path) {
    var code = path.getAttribute('data-name');
    var isActive = activeStatesList.indexOf(code) !== -1;

    path.style.fill = '#d1d5db';
    path.style.stroke = '#fff';
    path.style.strokeWidth = '0.8px';
    path.style.transition = 'fill 0.2s ease';

    if (isActive) {
      var isPrimary = code === 'TX' || code === 'CA' || code === 'NY';
      path.style.fill = isPrimary ? '#8b1538' : '#e05a6d';
      path.style.cursor = 'pointer';

      path.addEventListener('mouseenter', function() {
        path.style.fill = isPrimary ? '#6b0f2a' : '#c0414f';
        var data = mapData[code];
        if (data && tooltip) {
          tooltipState.textContent = code;
          tooltipPartners.textContent = data.partners + ' Restaurant Partners';
          tooltipLocations.textContent = data.locations + ' Supported Locations';
          tooltipTags.innerHTML = '';
          if (data.tags) {
            data.tags.split('•').forEach(function(tag) {
              var span = document.createElement('span');
              span.className = 'rp-map-tooltip-tag';
              span.textContent = tag.trim();
              tooltipTags.appendChild(span);
            });
          }
          tooltip.classList.add('visible');
        }
      });

      path.addEventListener('mousemove', function(e) {
        if (tooltip) {
          var rect = container.getBoundingClientRect();
          tooltip.style.left = (e.clientX - rect.left + 12) + 'px';
          tooltip.style.top = (e.clientY - rect.top - 10) + 'px';
        }
      });

      path.addEventListener('mouseleave', function() {
        path.style.fill = isPrimary ? '#8b1538' : '#e05a6d';
        if (tooltip) tooltip.classList.remove('visible');
      });
    }
  });
})();
</script>
