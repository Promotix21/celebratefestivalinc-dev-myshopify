<!-- sections/hexagon-grid.liquid -->
<style>
  .hexagon-section {
    padding: {{ section.settings.section_padding_desktop }}px 20px;
    background-color: {{ section.settings.background_color }};
    font-family: Arial, sans-serif;
  }

  .hexagon-container {
    max-width: 1500px;
    margin: 0 auto;
    text-align: center;
    padding: 0 10px;
  }

  .hexagon-title {
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: bold;
    line-height: 1.2;
    margin-top: 0;
    margin-bottom: {{ section.settings.title_margin_desktop }}px;
  }

  .brand-grid-wrap {
    line-height: 0;
  }

  .hexagon-grid,
  .hexagon-grid-wide {
    position: relative;
    margin: 0 auto;
    vertical-align: top;
  }

  .hexagon-grid {
    display: inline-block;
    --hex-size-desktop: {{ section.settings.hex_size_desktop }}px;
    --hex-height-desktop: {{ section.settings.hex_height_desktop }}px;
    --vertical-spacing-desktop: {{ section.settings.vertical_spacing_desktop }}px;
    --horizontal-spacing-desktop: {{ section.settings.horizontal_spacing_desktop }}px;
    --offset-desktop: {{ section.settings.honeycomb_offset_desktop }}px;
  }

  .hexagon-grid-wide {
    display: none;
  }

  .hex-row,
  .wide-hex-row {
    display: flex;
    justify-content: center;
  }

  .hex-row {
    margin-bottom: calc(-1 * var(--vertical-spacing-desktop));
  }

  .hex-row:last-child {
    margin-bottom: 0;
  }

  /* Honeycomb offset for standard desktop/tablet rows */
  .hex-row:nth-child(even) {
    transform: translateX(var(--offset-desktop));
  }

  .hexagon-link {
    text-decoration: none;
    display: inline-block;
    line-height: 0;
  }

  .hexagon-item {
    margin: 0 calc(-1 * var(--horizontal-spacing-desktop));
    cursor: pointer;
    transition: transform 0.25s ease, filter 0.25s ease;
    position: relative;
  }

  .hexagon-item:hover {
    transform: scale({{ section.settings.hover_scale }});
    z-index: 10;
    filter: drop-shadow(0 8px 12px rgba(24, 48, 82, 0.10));
  }

  .hexagon-svg {
    width: var(--hex-size-desktop);
    height: var(--hex-height-desktop);
    display: block;
  }

  .hex-shape {
    fill: {{ section.settings.hex_background }};
    stroke-width: {{ section.settings.hex_border_width }};
  }

  .hex-logo {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }

  /* Stats: compact card so it visually belongs to the brand grid */
  .stats-section {
    width: min(690px, calc(100% - 24px));
    margin: 26px auto 0;
    padding: 16px 18px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(29, 58, 94, 0.08);
    border-radius: 20px;
    box-shadow: 0 10px 28px rgba(31, 54, 83, 0.07);
    box-sizing: border-box;
  }

  .stat-item {
    min-width: 0;
    padding: 3px 24px;
    text-align: center;
    text-decoration: none;
    position: relative;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .stat-item + .stat-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10%;
    bottom: 10%;
    width: 1px;
    background: rgba(30, 58, 92, 0.11);
  }

  .stat-item:hover {
    transform: translateY(-3px);
    opacity: 0.9;
  }

  .stat-number {
    font-size: 44px;
    font-weight: 800;
    color: {{ section.settings.stats_number_color }};
    line-height: 1;
    margin-bottom: 7px;
    white-space: nowrap;
    letter-spacing: -1px;
  }

  .stat-label {
    font-size: 12px;
      color: #FF8448;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    line-height: 1.25;
  }

  .view-brands-btn {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background-color: {{ section.settings.button_background_color }};
    color: {{ section.settings.button_text_color }};
    padding: 13px 28px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(248, 84, 84, 0.20);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .view-brands-btn::after {
    content: "\2192";
    font-size: 17px;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .view-brands-btn:hover {
    background-color: {{ section.settings.button_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 11px 24px rgba(248, 84, 84, 0.26);
  }

  .view-brands-btn:hover::after {
    transform: translateX(3px);
  }

  /*
    Wide desktop layout.
    Uses the SAME 42 configured logos, but redistributes them as 10 / 11 / 10 / 11.
    This fills wide monitors without requiring new Shopify logo settings.
  */
  @media screen and (min-width: 1500px) {
    .hexagon-container {
      max-width: 1760px;
      padding: 0 14px;
    }

    .brand-grid-wrap--wide-ready .hexagon-grid {
      display: none;
    }

    .brand-grid-wrap--wide-ready .hexagon-grid-wide {
      display: inline-block;
      --wide-hex-size: clamp(145px, {{ section.settings.hex_size_desktop }}px, 170px);
      --wide-hex-height: calc(var(--wide-hex-size) * 0.875);
      --wide-horizontal-overlap: clamp(9px, 0.7vw, 12px);
      --wide-vertical-overlap: clamp(52px, {{ section.settings.vertical_spacing_desktop }}px, 64px);
      --wide-step: calc(var(--wide-hex-size) - var(--wide-horizontal-overlap) - var(--wide-horizontal-overlap));
    }

    .wide-hex-row {
      margin-bottom: calc(-1 * var(--wide-vertical-overlap));
    }

    .wide-hex-row:last-child {
      margin-bottom: 0;
    }

    /* 10-item rows are naturally centered inside the 11-item row width. */

    .hexagon-grid-wide .hexagon-item {
      margin: 0 calc(-1 * var(--wide-horizontal-overlap));
    }

    .hexagon-grid-wide .hexagon-svg {
      width: var(--wide-hex-size);
      height: var(--wide-hex-height);
    }

    .stats-section {
      margin-top: 24px;
    }
  }

  /* Tablet */
  @media screen and (max-width: 1024px) and (min-width: 768px) {
    .hexagon-section {
      padding: {{ section.settings.section_padding_tablet }}px 15px;
    }

    .hexagon-container {
      padding: 0 8px;
    }

    .hexagon-title {
      font-size: {{ section.settings.title_size_tablet }}px;
      margin-bottom: {{ section.settings.title_margin_tablet }}px;
    }

    .hexagon-grid {
      --hex-size-desktop: {{ section.settings.hex_size_tablet }}px;
      --hex-height-desktop: {{ section.settings.hex_height_tablet }}px;
      --vertical-spacing-desktop: {{ section.settings.vertical_spacing_tablet }}px;
      --horizontal-spacing-desktop: {{ section.settings.horizontal_spacing_tablet }}px;
      --offset-desktop: {{ section.settings.honeycomb_offset_tablet }}px;
    }

    .stats-section {
      width: min(620px, calc(100% - 20px));
      margin-top: 24px;
      padding: 14px 12px;
    }

    .stat-number {
      font-size: 38px;
    }

    .stat-item {
      padding: 3px 14px;
    }
  }

  /*
    Mobile: keep the ORIGINAL source-code honeycomb exactly as before.
    We only pull the stats upward to cancel the invisible space created by translateY.
  */
  @media screen and (max-width: 767px) {
    .hexagon-section {
      padding: {{ section.settings.section_padding_mobile }}px 8px;
    }

    .hexagon-container {
      padding: 0;
    }

    .hexagon-title {
      font-size: {{ section.settings.title_size_mobile }}px;
      margin-bottom: {{ section.settings.title_margin_mobile }}px;
      line-height: 1.3;
    }

    .hexagon-grid {
      --hex-size-desktop: {{ section.settings.hex_size_mobile }}px;
      --hex-height-desktop: {{ section.settings.hex_height_mobile }}px;
      --vertical-spacing-desktop: 0px;
      --horizontal-spacing-desktop: 0px;
      --offset-desktop: 0px;
    }

    .hexagon-grid-wide {
      display: none !important;
    }

    /* ORIGINAL mobile grid behavior: 6 / 5 / 6 / 5 / 6 */
    .hexagon-section .hexagon-grid .hex-row {
      justify-content: center !important;
      margin: 0 !important;
    }

    .hexagon-section .hexagon-grid .hex-row:nth-child(2) {
      transform: translateY(-16px) !important;
    }

    .hexagon-section .hexagon-grid .hex-row:nth-child(3) {
      transform: translateY(-32px) !important;
    }

    .hexagon-section .hexagon-grid .hex-row:nth-child(4) {
      transform: translateY(-48px) !important;
    }

    .hexagon-section .hexagon-grid .hex-row:nth-child(5) {
      transform: translateY(-64px) !important;
    }

    .hexagon-section .hexagon-grid .hexagon-item {
      margin: 0 -6px !important;
    }

    .hexagon-link.hide-on-mobile {
      display: none !important;
    }

    /*
      translateY keeps the original row height in the document flow.
      These negative margins remove only that invisible blank area,
      without changing the logo layout itself.
    */
    .stats-section--five-rows {
      margin-top: -50px;
    }

    .stats-section--four-rows {
      margin-top: -34px;
    }

    .stats-section {
      width: min(360px, calc(100% - 12px));
      padding: 13px 4px;
      border-radius: 17px;
      box-shadow: 0 7px 20px rgba(31, 54, 83, 0.06);
    }

    .stat-item {
      padding: 2px 5px;
    }

    .stat-item + .stat-item::before {
      top: 12%;
      bottom: 12%;
    }

    .stat-number {
      font-size: clamp(24px, 7vw, 30px);
      margin-bottom: 6px;
      letter-spacing: -0.7px;
    }

    .stat-label {
      font-size: clamp(8px, 2.45vw, 10px);
      letter-spacing: 0.45px;
      line-height: 1.2;
    }

    .view-brands-btn {
      margin-top: 14px;
      min-width: 178px;
      padding: 13px 23px;
      font-size: 14px;
      box-shadow: 0 7px 16px rgba(248, 84, 84, 0.20);
    }

    .view-brands-btn:active {
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hexagon-item,
    .stat-item,
    .view-brands-btn,
    .view-brands-btn::after {
      transition: none;
    }
  }
</style>

<section class="hexagon-section">
  <div class="hexagon-container">
    {% if section.settings.title != blank %}
      <h2 class="hexagon-title">{{ section.settings.title }}</h2>
    {% endif %}

    {%- comment %} Default brand links mapping for 18 priority brands {% endcomment -%}
    {%- assign brand_links = '/collections/atosa-all,/collections/gsw,/collections/thunder-group,/collections/combi-oven-rational,/pages/cf-robot-coupe,/pages/cf-cac,/pages/turboair-page,/pages/waring,/pages/cf-eurodib,/collections/winco,/collections/sammic,/pages/globe,/collections/shaan,/collections/somerset,/pages/global-solutions,/collections/rotoquip,/collections/kwitex,/collections/yanco-product-collection' | split: ',' -%}

    {%- assign row5_filled = 0 -%}
    {%- for i in (1..8) -%}
      {%- assign lk = 'logo_row5_' | append: i -%}
      {%- if section.settings[lk] != blank -%}{%- assign row5_filled = row5_filled | plus: 1 -%}{%- endif -%}
    {%- endfor -%}

    <div class="brand-grid-wrap{% if row5_filled == 8 %} brand-grid-wrap--wide-ready{% endif %}">
      {%- if row5_filled == 8 -%}
      <div class="hexagon-grid-wide" aria-label="Featured brands">
        <!-- Wide desktop row 1: 10 logos -->
        <div class="wide-hex-row">
      {% for i in (1..8) %}
        {% assign logo_key = 'logo_row1_' | append: i %}
        {% assign link_key = 'link_row1_' | append: i %}
        {% assign logo = section.settings[logo_key] %}
        {% assign link_url = section.settings[link_key] %}
        {% assign brand_idx = i | minus: 1 | plus: 0 %}
        {% assign default_brand_link = brand_links[brand_idx] | default: '/pages/brands' %}
        {% assign hex_link = link_url | default: default_brand_link %}
        <a href="{{ hex_link }}" class="hexagon-link">
          <div class="hexagon-item">
            <svg class="hexagon-svg" viewBox="0 0 80 70" aria-hidden="true">
              <defs>
                <linearGradient id="hexBorderGradient-wide-r1-{{ i }}" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="{{ section.settings.hex_border_gradient_start }}" />
                  <stop offset="100%" stop-color="{{ section.settings.hex_border_gradient_end }}" />
                </linearGradient>
              </defs>
              <polygon class="hex-shape"
                points="40,2 70,18 70,52 40,68 10,52 10,18"
                fill="{{ section.settings.hex_background }}"
                stroke="url(#hexBorderGradient-wide-r1-{{ i }})"
                stroke-width="{{ section.settings.hex_border_width }}" />
              <foreignObject x="17" y="25" width="46" height="36">
                {% if logo != blank %}
                  <img class="hex-logo" src="{{ logo | img_url: '200x200' }}" alt="Brand Logo {{ brand_idx | plus: 1 }}" loading="lazy">
                {% else %}
                  <img class="hex-logo" src="https://cf-images.hiraya.digital/emails/4th-july/images/footer_logo.png" alt="Placeholder Logo" loading="lazy">
                {% endif %}
              </foreignObject>
            </svg>
          </div>
        </a>
      {% endfor %}
      {% for i in (1..2) %}
