<!-- sections/industry-use-cases.liquid -->
<style>
  .industry-use-cases {
    padding: 10px 0;
    background-color: #f8f9fa;
    width: 100%;
  }

  .industry-use-cases__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .industry-use-cases__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    text-align: left;
    margin-bottom: 12px;
  }

  .industry-use-cases__header-text {
    flex: 1;
    min-width: 0;
  }

  .industry-use-cases__view-all--header {
    flex-shrink: 0;
    margin-top: 0;
  }

  .industry-use-cases__title {
    font-size: 36px;
    font-weight: 700;
    color: #2d3748;
    margin-top: 0;
    margin-bottom: 0;
    line-height: 1.2;
  }

  .industry-use-cases__subtitle {
    display: block;
    font-size: 18px;
    font-weight: 400;
    color: #718096;
    margin-top: 10px;
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .industry-use-cases__title {
      font-size: 28px;
    }
    .industry-use-cases__subtitle {
      font-size: 16px;
    }
    .industry-use-cases__header {
      flex-direction: column;
      text-align: center;
    }
    .industry-use-cases__view-all--header {
      display: none;
    }
    .industry-use-cases__view-all-wrap--mobile {
      display: block;
    }
  }
  
  .industry-use-cases__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 30px;
  }
  
  .use-case-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .use-case-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
  }
  
  .use-case-card__image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  
  .use-case-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .use-case-card__content {
    padding: 8px 16px;
  }
  
  .use-case-card__image-link {
    display: block;
    text-decoration: none;
  }

  .use-case-card__title-link {
    text-decoration: none;
    display: block;
  }

  .use-case-card__title-link:hover .use-case-card__title {
    color: var(--accent-color, #f14f56);
  }

  .use-case-card__title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--primary-color, #244469);
    margin-top: 0;
    margin-bottom: 0;
    transition: color 0.2s ease;
  }

  .use-case-card__description {
    font-size: 0.95rem;
    color: #666;
    margin-top: 4px;
    margin-bottom: 0;
    line-height: 1.5;
  }
  
  .use-case-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 25px;
  }
  
  .use-case-card__tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: #f1f5f9;
    color: var(--primary-color, #244469);
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    gap: 8px;
  }

  .use-case-card__tag-image {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .use-case-card__tag:hover {
    background: var(--primary-color, #244469);
    color: white;
    transform: translateY(-1px);
  }
  
  .use-case-card__cta {
    display: inline-flex;
    align-items: center;
    color: var(--accent-color, #f14f56);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }
  
  .use-case-card__cta:hover {
    color: var(--primary-color, #244469);
    transform: translateX(3px);
  }
  
  .use-case-card__cta svg {
    margin-left: 8px;
    width: 16px;
    height: 16px;
  }
  
  .industry-use-cases__cta {
    background: var(--primary-color, #244469);
    border-radius: 12px;
    padding: 50px 30px;
    text-align: center;
    color: white;
  }
  
  .industry-use-cases__cta-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: white;
  }
  
  .industry-use-cases__cta-subtitle {
    font-size: 1.1rem;
    margin-bottom: 30px;
    opacity: 0.9;
    line-height: 1.5;
  }
  
  .industry-use-cases__cta-button {
    display: inline-flex;
    align-items: center;
    background: var(--accent-color, #f14f56);
    color: white;
    padding: 15px 30px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }
  
  .industry-use-cases__cta-button:hover {
    background: #e63946;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(241, 79, 86, 0.4);
  }
  
  .industry-use-cases__cta-button svg {
    margin-right: 8px;
    width: 18px;
    height: 18px;
  }

  .industry-use-cases__view-all-wrap {
    text-align: center;
    margin-top: 40px;
  }

  .industry-use-cases__view-all-wrap--mobile {
    display: none;
  }

  .industry-use-cases__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-color, #244469);
    color: #fff;
    padding: 15px 34px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .industry-use-cases__view-all:hover {
    background: #1b3350;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(36, 68, 105, 0.35);
  }

  .industry-use-cases__view-all svg {
    width: 16px;
    height: 16px;
  }

  /* Tablet Styles - 2x4 grid */
  @media (max-width: 1024px) {
    .industry-use-cases__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .industry-use-cases__container {
      padding: 0 20px;
    }
    
    .industry-use-cases__title {
      font-size: 2.2rem;
    }
    
    .industry-use-cases__cta-title {
      font-size: 1.8rem;
    }
  }
  
  /* Mobile Styles - 1x6 grid */
  @media (max-width: 768px) {
    .industry-use-cases {
      padding: 40px 0;
    }
    
    .industry-use-cases__container {
      padding: 0 15px;
    }
    
    .industry-use-cases__grid {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }
    
    .industry-use-cases__title {
      font-size: 1.8rem;
    }
    
    .industry-use-cases__subtitle {
      font-size: 1rem;
    }
    
    .use-case-card__content {
      padding: 8px 14px;
    }
    
    .use-case-card__title {
      font-size: 1.2rem;
    }
    
    .use-case-card__description {
      font-size: 0.9rem;
    }
    
    .industry-use-cases__cta {
      padding: 40px 20px;
    }
    
    .industry-use-cases__cta-title {
      font-size: 1.6rem;
    }
    
    .industry-use-cases__cta-subtitle {
      font-size: 1rem;
    }
  }
  
  /* CSS Custom Properties for Schema Colors */
  .industry-use-cases {
    --primary-color: {{ section.settings.primary_color }};
    --accent-color: {{ section.settings.accent_color }};
  }
</style>

<div class="industry-use-cases">
  <div class="industry-use-cases__container">
    <!-- Header -->
    <div class="industry-use-cases__header">
      <div class="industry-use-cases__header-text">
        <h2 class="industry-use-cases__title">{{ section.settings.title }}</h2>
        <p class="industry-use-cases__subtitle">{{ section.settings.subtitle }}</p>
      </div>
      {% if section.settings.show_view_all %}
        <a href="{{ section.settings.view_all_url | default: '/pages/use-cases' }}" class="industry-use-cases__view-all industry-use-cases__view-all--header">
          {{ section.settings.view_all_text | default: 'View All Use Cases' }}
          <svg fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
          </svg>
        </a>
      {% endif %}
    </div>
    
    <!-- Use Cases Grid -->
    <div class="industry-use-cases__grid">
      {% for block in section.blocks %}
        {% if block.type == 'use_case' %}
          <div class="use-case-card" {{ block.shopify_attributes }}>
            {% assign card_url = block.settings.cta_url | default: '#' %}
            <a href="{{ card_url }}" class="use-case-card__image-link">
              <div class="use-case-card__image">
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 400 }}"
                       alt="{{ block.settings.title }}"
                       loading="lazy">
                {% else %}
                  <div style="background: #f0f0f0; height: 100%; display: flex; align-items: center; justify-content: center; color: #999;">
                    Add Image
                  </div>
                {% endif %}
              </div>
            </a>

            <div class="use-case-card__content">
              <a href="{{ card_url }}" class="use-case-card__title-link">
                <h3 class="use-case-card__title">{{ block.settings.title }}</h3>
              </a>
              <p class="use-case-card__description">{{ block.settings.description }}</p>

              {% assign subitems_exist = false %}
              {% if block.settings.subitem_1_title != blank or block.settings.subitem_2_title != blank or block.settings.subitem_3_title != blank or block.settings.subitem_4_title != blank %}
                {% assign subitems_exist = true %}
              {% endif %}

              {% if subitems_exist %}
                <div class="use-case-card__tags">
                  {% for i in (1..4) %}
                    {% capture image_key %}subitem_{{ i }}_image{% endcapture %}
                    {% capture title_key %}subitem_{{ i }}_title{% endcapture %}
                    {% capture collection_key %}subitem_{{ i }}_collection{% endcapture %}
                    
                    {% assign subitem_image = block.settings[image_key] %}
                    {% assign subitem_title = block.settings[title_key] %}
                    {% assign subitem_collection = block.settings[collection_key] %}
                    
                    {% if subitem_title != blank %}
                      <a href="{{ subitem_collection.url | default: '#' }}" class="use-case-card__tag">
                        {% if subitem_image != blank %}
                          <img src="{{ subitem_image | image_url: width: 48 }}" alt="{{ subitem_title | escape }}" class="use-case-card__tag-image" loading="lazy" width="24" height="24">
                        {% endif %}
                        <span class="use-case-card__tag-text">{{ subitem_title }}</span>
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if block.settings.cta_text != blank and block.settings.cta_url != blank %}
                <a href="{{ block.settings.cta_url }}" class="use-case-card__cta">
                  {{ block.settings.cta_text }}
                  <svg fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
                  </svg>
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- View All Use Cases Button (mobile — shown at bottom) -->
    {% if section.settings.show_view_all %}
      <div class="industry-use-cases__view-all-wrap industry-use-cases__view-all-wrap--mobile">
        <a href="{{ section.settings.view_all_url | default: '/pages/use-cases' }}" class="industry-use-cases__view-all">
          {{ section.settings.view_all_text | default: 'View All Use Cases' }}
          <svg fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    {% endif %}

    <!-- Bottom CTA Section -->
    {% if section.settings.show_bottom_cta %}
      <div class="industry-use-cases__cta">
        <h3 class="industry-use-cases__cta-title">{{ section.settings.cta_title }}</h3>
        <p class="industry-use-cases__cta-subtitle">{{ section.settings.cta_subtitle }}</p>
        
        {% if section.settings.cta_button_text != blank and section.settings.cta_button_url != blank %}
          <a href="{{ section.settings.cta_button_url }}" class="industry-use-cases__cta-button">
            <svg fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd"></path>
            </svg>
            {{ section.settings.cta_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Industry Use Cases",
  "tag": "section",
  "class": "section-industry-use-cases",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Industry Use Cases"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Equipment solutions for every type of restaurant"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#244469"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#f14f56"
    },
    {
      "type": "header",
      "content": "Bottom CTA Section"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_cta",
      "label": "Show Bottom CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA Title",
      "default": "Don't See Your Restaurant Type?"
    },
    {
      "type": "textarea",
      "id": "cta_subtitle",
      "label": "CTA Subtitle",
      "default": "Our equipment experts work with all types of food businesses. Get personalized recommendations for your specific needs."
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA Button Text",
      "default": "Get Free Consultation"
    },
    {
      "type": "url",
      "id": "cta_button_url",
      "label": "CTA Button URL"
    },
    {
      "type": "header",
      "content": "View All Use Cases Button"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All Use Cases' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button Text",
      "default": "View All Use Cases"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Button URL",
      "info": "Defaults to /pages/use-cases"
    }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Use Case Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description"
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection Handle",
          "info": "The collection to filter (e.g., 'restaurant-equipment')",
          "default": "all"
        },
        {
          "type": "header",
          "content": "Subitem 1"
        },
        {
          "type": "image_picker",
          "id": "subitem_1_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subitem_1_title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "subitem_1_collection",
          "label": "Collection"
        },
        {
          "type": "header",
          "content": "Subitem 2"
        },
        {
          "type": "image_picker",
          "id": "subitem_2_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subitem_2_title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "subitem_2_collection",
          "label": "Collection"
        },
        {
          "type": "header",
          "content": "Subitem 3"
        },
        {
          "type": "image_picker",
          "id": "subitem_3_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subitem_3_title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "subitem_3_collection",
          "label": "Collection"
        },
        {
          "type": "header",
          "content": "Subitem 4"
        },
        {
          "type": "image_picker",
          "id": "subitem_4_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subitem_4_title",
          "label": "Title"
        },
        {
          "type": "collection",
          "id": "subitem_4_collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Button Text",
          "default": "View Equipment"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industry Use Cases",
      "blocks": [
        {
          "type": "use_case",
          "settings": {
            "title": "Pizza Restaurants",
            "description": "Complete solutions for pizzerias from dough preparation to wood-fired perfection.",
            "collection_handle": "restaurant-equipment",
            "cta_text": "View Equipment",
            "cta_url": "/collections/pizza-equipment"
