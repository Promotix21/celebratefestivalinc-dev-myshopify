{% comment %}
  ============================================================
  SERVICE JOURNEY — V2 (Premium redesign)
  ------------------------------------------------------------
  A flagship, conversion-focused journey page. Fresh design
  language — NOT a rearrangement of the original page-journey.
  Composition per section is deliberately different:
    1. Hero          — split layout, contained banner on navy
    2. Process        — interactive stepper (nav / content / image)
    3. Consultation   — premium dark section, contained blueprint
    4. Final CTA      — story close with 4-image gallery
  Industry Use Cases is added separately in the template JSON.
  ============================================================
{% endcomment %}

{%- liquid
  assign nb = section.settings.navy | default: '#1A365D'
  assign coral = section.settings.coral | default: '#FF5B5B'
-%}

{% style %}
  .jv2 {
    --jv-navy: {{ nb }};
    --jv-navy-deep: #0f2138;
    --jv-coral: {{ coral }};
    --jv-gold: #d4af37;
    --jv-ink: #0f172a;
    --jv-text: #475569;
    --jv-muted: #94a3b8;
    --jv-line: #e6ebf2;
    --jv-bg: #f7f9fc;
    --jv-white: #ffffff;
    --jv-radius: 20px;
    --jv-shadow: 0 18px 50px rgba(15, 33, 56, 0.10);
    --jv-shadow-sm: 0 8px 24px rgba(15, 33, 56, 0.08);
    --jv-fh: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
    --jv-fb: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--jv-fb);
    color: var(--jv-ink);
    overflow: clip;
  }
  .jv2 *, .jv2 *::before, .jv2 *::after { box-sizing: border-box; }
  .jv2 img { display: block; max-width: 100%; }
  .jv-wrap { max-width: 1240px; margin: 0 auto; padding: 0 32px; }

  .jv-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--jv-fb); font-size: 12px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--jv-coral);
  }
  .jv-eyebrow::before { content: ''; width: 22px; height: 2px; background: var(--jv-coral); border-radius: 2px; }

  .jv-btn {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--jv-fh); font-size: 15px; font-weight: 600;
    padding: 15px 30px; border-radius: 12px; border: none;
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
  }
  .jv-btn svg { width: 18px; height: 18px; transition: transform .25s ease; }
  .jv-btn:hover svg { transform: translateX(4px); }
  .jv-btn--primary { background: var(--jv-coral); color: #fff; box-shadow: 0 8px 24px rgba(255,91,91,.32); }
  .jv-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(255,91,91,.42); color: #fff; }
  .jv-btn--ghost { background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(255,255,255,.22); }
  .jv-btn--ghost:hover { background: rgba(255,255,255,.16); transform: translateY(-2px); color: #fff; }

  /* Scroll reveal */
  .jv-rise { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); }
  .jv-rise.is-in { opacity: 1; transform: none; }

  /* ============ 1. HERO ============ */
  .jv-hero { position: relative; display: grid; grid-template-columns: 1fr 1fr;
    background: #09224a; color: #fff; overflow: hidden; }
  .jv-hero__left { background: #09224a; display: flex; align-items: center; padding: 76px 40px; }
  .jv-hero__right { position: relative; min-height: 100%; }
  .jv-hero__art { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .jv-hero__inner { position: relative; z-index: 2; width: 100%; max-width: 600px; margin-left: auto; }
  .jv-hero__pill {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 22px;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16);
    border-radius: 999px; padding: 7px 16px; font-size: 12.5px; font-weight: 600;
    letter-spacing: .04em; color: rgba(255,255,255,.9); backdrop-filter: blur(8px);
  }
  .jv-hero__pill svg { width: 15px; height: 15px; }
  .jv-hero__title { font-family: var(--jv-fh); font-weight: 800; line-height: 1.06; color: #fff;
    font-size: clamp(34px, 4.6vw, 60px); letter-spacing: -0.02em; margin: 0 0 18px; }
  .jv-hero__title .c { background: linear-gradient(120deg, var(--jv-coral), #ff8f6b); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .jv-hero__title .g { background: linear-gradient(120deg, var(--jv-gold), #f4d774); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .jv-hero__sub { font-size: 17px; line-height: 1.65; color: rgba(255,255,255,.72); max-width: 500px; margin: 0 0 30px; }
  .jv-hero__actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .jv-hero__trust { display: flex; align-items: center; gap: 10px; }
  .jv-hero__avatars { display: flex; }
  .jv-hero__avatars span { width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--jv-navy);
    margin-left: -10px; background-size: cover; background-position: center; box-shadow: 0 2px 6px rgba(0,0,0,.3); }
  .jv-hero__avatars span:first-child { margin-left: 0; }
  .jv-hero__trust small { font-size: 12.5px; font-weight: 600; color: rgba(255,255,255,.82); line-height: 1.3; }

  /* Hero step chips (full width under the split) */
  .jv-hero__steps { grid-column: 1 / -1; position: relative; border-top: 1px solid rgba(255,255,255,.12);
    background: var(--jv-navy); }
  .jv-hero__steps ol { list-style: none; margin: 0 auto; max-width: 1240px; padding: 18px 32px;
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 8px; }
  .jv-hero__chip { display: flex; align-items: center; gap: 10px; justify-content: center; position: relative; }
  .jv-hero__chip b { font-family: var(--jv-fh); font-size: 12px; font-weight: 700; color: var(--jv-coral); }
  .jv-hero__chip span { font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.78); }
  .jv-hero__chip:not(:last-child)::after { content: '→'; position: absolute; right: -6px; color: rgba(255,255,255,.28); font-size: 13px; }

  /* ============ 2. PROCESS (interactive stepper) ============ */
  .jv-proc { background: var(--jv-bg); padding: 72px 0; }
  .jv-proc__head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
  .jv-proc__head h2 { font-family: var(--jv-fh); font-weight: 800; letter-spacing: -.02em;
    font-size: clamp(26px, 3.2vw, 38px); color: var(--jv-ink); margin: 14px 0 10px; }
  .jv-proc__head p { font-size: 15.5px; line-height: 1.6; color: var(--jv-text); margin: 0; }

  .jv-stepper { display: grid; grid-template-columns: 240px 1fr; gap: 28px; align-items: stretch; }

  /* Left nav */
  .jv-nav { position: relative; }
  .jv-nav__line { position: absolute; left: 15px; top: 12px; bottom: 12px; width: 2px; background: var(--jv-line); border-radius: 2px; }
  .jv-nav__fill { position: absolute; left: 0; top: 0; width: 100%; background: linear-gradient(180deg, var(--jv-coral), var(--jv-gold)); border-radius: 2px; transition: height .45s cubic-bezier(.22,1,.36,1); }
  .jv-nav__btn { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; width: 100%;
    background: none; border: none; cursor: pointer; text-align: left; padding: 9px 10px 9px 0; font-family: var(--jv-fb); }
  .jv-nav__dot { flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: var(--jv-white);
    border: 2px solid var(--jv-line); color: var(--jv-muted); font-family: var(--jv-fh); font-weight: 700; font-size: 12px;
    display: flex; align-items: center; justify-content: center; transition: all .3s ease; }
  .jv-nav__txt { font-size: 14.5px; font-weight: 600; color: var(--jv-text); transition: color .3s ease; }
  .jv-nav__btn.is-active .jv-nav__dot { background: var(--jv-coral); border-color: var(--jv-coral); color: #fff; box-shadow: 0 0 0 4px rgba(255,91,91,.18); }
  .jv-nav__btn.is-active .jv-nav__txt { color: var(--jv-ink); font-weight: 700; }
  .jv-nav__btn.is-done .jv-nav__dot { background: var(--jv-navy); border-color: var(--jv-navy); color: #fff; }
  .jv-nav__btn:hover .jv-nav__txt { color: var(--jv-ink); }

  /* Right content panel */
  .jv-panel { background: var(--jv-white); border: 1px solid var(--jv-line); border-radius: var(--jv-radius);
    box-shadow: var(--jv-shadow); overflow: hidden; display: grid; grid-template-columns: 1fr 1.05fr; min-height: 430px; }
  .jv-panel__body { padding: 40px 36px; display: flex; flex-direction: column; }
  .jv-panel__num { font-family: var(--jv-fh); font-weight: 800; font-size: 46px; line-height: 1;
    background: linear-gradient(120deg, var(--jv-coral), var(--jv-gold)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .jv-panel__tag { font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--jv-coral); margin: 14px 0 6px; }
  .jv-panel__title { font-family: var(--jv-fh); font-weight: 800; font-size: 25px; letter-spacing: -.01em; color: var(--jv-ink); margin: 0 0 12px; }
  .jv-panel__desc { font-size: 14.5px; line-height: 1.65; color: var(--jv-text); margin: 0 0 20px; }
  .jv-panel__bullets { list-style: none; margin: 0 0 auto; padding: 0; display: grid; gap: 11px; }
  .jv-panel__bullets li { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 500; color: var(--jv-ink); }
  .jv-panel__bullets svg { flex-shrink: 0; width: 18px; height: 18px; color: var(--jv-coral); }
  .jv-panel__media { position: relative; overflow: hidden; background: var(--jv-navy); }
  .jv-panel__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* crossfade panes */
  .jv-pane { display: none; animation: jv-fade .5s cubic-bezier(.22,1,.36,1); }
  .jv-pane.is-active { display: contents; }
  @keyframes jv-fade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .jv-panel__body, .jv-panel__media { animation: jv-fade .5s cubic-bezier(.22,1,.36,1); }

  /* controls */
  .jv-proc__controls { display: flex; align-items: center; justify-content: space-between; margin-top: 22px; }
  .jv-proc__count { font-family: var(--jv-fh); font-weight: 700; font-size: 14px; color: var(--jv-text); }
  .jv-proc__count b { color: var(--jv-coral); font-size: 18px; }
  .jv-proc__arrows { display: flex; gap: 10px; }
  .jv-arrow { width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--jv-line); background: var(--jv-white);
    color: var(--jv-navy); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .25s ease; }
  .jv-arrow:hover { background: var(--jv-navy); color: #fff; border-color: var(--jv-navy); }
  .jv-arrow:disabled { opacity: .35; cursor: not-allowed; }
  .jv-arrow svg { width: 20px; height: 20px; }

  /* ============ 3. CONSULTATION ============ */
  .jv-consult { position: relative; background: #01224e; color: #fff; overflow: hidden; }
  .jv-consult__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    max-width: 1240px; margin: 0 auto; padding: 68px 32px; }
  /* contained blueprint on navy, right/left aligned */
  .jv-consult__media { display: flex; align-items: center; justify-content: center; }
  .jv-consult__media img { width: 100%; max-height: 460px; object-fit: contain; }
  .jv-consult__title { font-family: var(--jv-fh); font-weight: 800; letter-spacing: -.02em; color: #fff;
    font-size: clamp(26px, 3.2vw, 38px); line-height: 1.1; margin: 14px 0 16px; }
  .jv-consult__title .c { color: var(--jv-coral); }
  .jv-consult__desc { font-size: 15.5px; line-height: 1.7; color: rgba(255,255,255,.72); margin: 0 0 26px; max-width: 480px; }
  .jv-consult__feats { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 22px; margin: 0 0 30px; }
  .jv-consult__feat { display: flex; align-items: center; gap: 12px; }
  .jv-consult__feat i { flex-shrink: 0; width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center;
    background: rgba(255,91,91,.14); }
  .jv-consult__feat svg { width: 20px; height: 20px; color: var(--jv-coral); }
  .jv-consult__feat span { font-size: 14px; font-weight: 600; line-height: 1.3; }
  .jv-consult__note { display: inline-flex; align-items: center; gap: 8px; margin-left: 16px; font-size: 13.5px; color: rgba(255,255,255,.6); }

  /* ============ 4. FINAL CTA ============ */
  .jv-final { background: #01224e; color: #fff; padding: 64px 0; }
  .jv-final__grid { display: grid; grid-template-columns: 0.85fr 1.4fr; gap: 48px; align-items: center; }
  .jv-final__title { font-family: var(--jv-fh); font-weight: 800; letter-spacing: -.02em; color: #fff;
    font-size: clamp(28px, 3.4vw, 42px); line-height: 1.08; margin: 16px 0 16px; }
  .jv-final__title .c { background: linear-gradient(120deg, var(--jv-gold), #f4d774);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .jv-final__text { font-size: 15.5px; line-height: 1.65; color: rgba(255,255,255,.72); margin: 0 0 28px; max-width: 420px; }
  .jv-final__gallery { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .jv-gcard { display: flex; flex-direction: column; align-items: center; }
  .jv-gcard__img { width: 100%; aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; position: relative;
    box-shadow: 0 14px 34px rgba(0,0,0,.34); transition: transform .35s cubic-bezier(.22,1,.36,1); }
  .jv-gcard:hover .jv-gcard__img { transform: translateY(-6px); }
  .jv-gcard__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .jv-gcard:hover .jv-gcard__img img { transform: scale(1.06); }
  .jv-gcard__badge { position: relative; z-index: 2; margin-top: -18px; width: 36px; height: 36px; border-radius: 50%;
    background: var(--jv-coral); color: #fff; font-family: var(--jv-fh); font-size: 13px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; border: 3px solid #01224e; }
  .jv-gcard__label { margin-top: 8px; font-family: var(--jv-fh); font-size: 14px; font-weight: 700; color: #fff; }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1024px) {
    .jv-panel { grid-template-columns: 1fr; }
    .jv-panel__media { min-height: 240px; }
    .jv-panel__media img { position: static; height: 240px; }
    .jv-panel__body { order: 2; }
  }
  @media (max-width: 900px) {
    .jv-hero { grid-template-columns: 1fr; }
    .jv-hero__left { padding: 52px 24px; order: 2; }
    .jv-hero__right { order: 1; min-height: 0; }
    .jv-hero__art { height: 300px; }
    .jv-consult__grid, .jv-final__grid { grid-template-columns: 1fr; gap: 32px; }
    .jv-consult__media { order: 2; }
    .jv-hero__steps ol { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2,1fr); gap: 12px; }
    .jv-hero__chip:not(:last-child)::after { display: none; }
    .jv-hero__chip { justify-content: flex-start; }
  }
  @media (max-width: 720px) {
    .jv-wrap, .jv-hero__inner, .jv-consult__grid, .jv-final__grid, .jv-hero__steps ol { padding-left: 20px; padding-right: 20px; }
    .jv-stepper { grid-template-columns: 1fr; gap: 20px; }
    .jv-nav { display: grid; grid-auto-flow: column; overflow-x: auto; gap: 8px; scrollbar-width: none; padding-bottom: 4px; }
    .jv-nav::-webkit-scrollbar { display: none; }
    .jv-nav__line { display: none; }
    .jv-nav__btn { flex-direction: column; gap: 6px; padding: 8px 12px; border: 1px solid var(--jv-line); border-radius: 12px; background: var(--jv-white); white-space: nowrap; }
    .jv-nav__txt { font-size: 12px; }
    .jv-panel__body { padding: 28px 22px; }
    .jv-consult__feats { grid-template-columns: 1fr; }
    .jv-final__gallery { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
{% endstyle %}

<div class="jv2" id="jv2-{{ section.id }}">

  {%- comment -%} ================= 1. HERO ================= {%- endcomment -%}
  {%- if section.settings.show_hero -%}
  {%- assign hero_banner = section.settings.hero_image -%}
  <section class="jv-hero">
    <div class="jv-hero__left">
    <div class="jv-hero__inner">
      <div class="jv-hero__content jv-rise">
        {%- if section.settings.hero_pill != blank -%}
          <span class="jv-hero__pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7.4L12 17.3 5.7 21.4 8 14 2 9.4h7.6z"/></svg>
            {{ section.settings.hero_pill }}
          </span>
        {%- endif -%}
        <h1 class="jv-hero__title">
          {{ section.settings.hero_title_1 }}
          <span class="c">{{ section.settings.hero_hl_1 }}</span>
          {{ section.settings.hero_title_2 }}
          <span class="g">{{ section.settings.hero_hl_2 }}</span>
        </h1>
        {%- if section.settings.hero_sub != blank -%}
          <p class="jv-hero__sub">{{ section.settings.hero_sub }}</p>
        {%- endif -%}
        <div class="jv-hero__actions">
          {%- if section.settings.hero_cta_text != blank -%}
            <a href="{{ section.settings.hero_cta_url | default: '#jv-process' }}" class="jv-btn jv-btn--primary">
              {{ section.settings.hero_cta_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.hero_trust_text != blank -%}
            <div class="jv-hero__trust">
              <div class="jv-hero__avatars">
                {%- for i in (1..3) -%}
                  {%- assign av_key = 'hero_avatar_' | append: i -%}
                  {%- assign av = section.settings[av_key] -%}
                  <span style="background-image:url('{% if av %}{{ av | image_url: width: 80 }}{% else %}{{ 'journey-v2-step-2-consultation.jpg' | asset_url }}{% endif %}');"></span>
                {%- endfor -%}
              </div>
              <small>{{ section.settings.hero_trust_text }}</small>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
    </div>

    {%- assign hero_banner_url = 'journey-v2-hero.jpg' | asset_url -%}
    {%- if hero_banner -%}{%- assign hero_banner_url = hero_banner | image_url: width: 1600 -%}{%- endif -%}
    <div class="jv-hero__right">
      <img class="jv-hero__art" src="{{ hero_banner_url }}"
           alt="{{ section.settings.hero_title_1 | strip_html | escape }}"
           width="1164" height="910" loading="eager" fetchpriority="high">
    </div>

    {%- comment -%} Hero step chips {%- endcomment -%}
    {%- if section.settings.show_hero_steps -%}
      <div class="jv-hero__steps">
        <ol>
          {%- assign chips = section.settings.hero_steps | default: '01 Design,02 Plan,03 Equip,04 Build,05 Open' | split: ',' -%}
          {%- for chip in chips -%}
            {%- assign parts = chip | strip | split: ' ' -%}
            <li class="jv-hero__chip"><b>{{ parts[0] }}</b><span>{{ parts | slice: 1, 9 | join: ' ' }}</span></li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}
  </section>
  {%- endif -%}

  {%- comment -%} ================= 2. PROCESS ================= {%- endcomment -%}
  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if section.settings.show_process and steps.size > 0 -%}
    <section class="jv-proc" id="jv-process">
      <div class="jv-wrap">
        <div class="jv-proc__head jv-rise">
          <span class="jv-eyebrow">{{ section.settings.proc_eyebrow | default: 'The Journey' }}</span>
          <h2>{{ section.settings.proc_title | default: '7 Steps to Your Successful Restaurant' }}</h2>
          <p>{{ section.settings.proc_sub | default: 'A proven process that turns your vision into a thriving restaurant.' }}</p>
        </div>

        <div class="jv-stepper jv-rise" data-stepper data-count="{{ steps.size }}">
          <!-- Left nav -->
          <div class="jv-nav" role="tablist" aria-label="Journey steps">
            <div class="jv-nav__line"><div class="jv-nav__fill" data-nav-fill></div></div>
            {%- for block in steps -%}
              <button class="jv-nav__btn {% if forloop.first %}is-active{% endif %}" data-nav="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="jv-nav__dot">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="jv-nav__txt">{{ block.settings.nav_label | default: block.settings.title }}</span>
              </button>
            {%- endfor -%}
          </div>

          <!-- Right panel -->
          <div class="jv-panel" data-panel>
            {%- for block in steps -%}
              {%- assign img_url = '' -%}
              {%- if block.settings.image -%}
                {%- assign img_url = block.settings.image | image_url: width: 1000 -%}
              {%- elsif block.settings.image_asset != blank -%}
                {%- assign img_url = block.settings.image_asset | asset_url -%}
              {%- endif -%}
              <div class="jv-pane {% if forloop.first %}is-active{% endif %}" data-pane="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <div class="jv-panel__body">
                  <div class="jv-panel__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
                  <h3 class="jv-panel__title">{{ block.settings.title }}</h3>
                  {%- if block.settings.tagline != blank -%}<div class="jv-panel__tag">{{ block.settings.tagline }}</div>{%- endif -%}
                  {%- if block.settings.description != blank -%}<p class="jv-panel__desc">{{ block.settings.description }}</p>{%- endif -%}
                  {%- assign bullets = block.settings.bullets | default: '' | split: ',' -%}
                  {%- if bullets.size > 0 -%}
                    <ul class="jv-panel__bullets">
                      {%- for b in bullets -%}
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>{{ b | strip }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
                <div class="jv-panel__media">
                  {%- if img_url != blank -%}
                    <img src="{{ img_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1000" height="750">
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="jv-proc__controls jv-rise">
          <div class="jv-proc__count"><b data-cur>01</b> / {{ steps.size | prepend: '0' | slice: -2, 2 }}</div>
          <div class="jv-proc__arrows">
            <button class="jv-arrow" data-prev aria-label="Previous step" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg></button>
            <button class="jv-arrow" data-next aria-label="Next step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 3. CONSULTATION ================= {%- endcomment -%}
  {%- if section.settings.show_consult -%}
    {%- assign bp = section.settings.consult_image -%}
    <section class="jv-consult">
      <div class="jv-consult__grid">
        <div class="jv-consult__media jv-rise">
          <img src="{% if bp %}{{ bp | image_url: width: 1300 }}{% else %}{{ 'journey-v2-blueprint.jpg' | asset_url }}{% endif %}"
               alt="Restaurant kitchen blueprint" loading="lazy" width="1300" height="975">
        </div>
        <div class="jv-consult__body jv-rise">
          <span class="jv-eyebrow">{{ section.settings.consult_eyebrow | default: 'Expert Guidance' }}</span>
          <h2 class="jv-consult__title">{{ section.settings.consult_title_1 | default: 'Need Help' }} <span class="c">{{ section.settings.consult_hl | default: 'Designing' }}</span> {{ section.settings.consult_title_2 | default: 'Your Restaurant?' }}</h2>
          <p class="jv-consult__desc">{{ section.settings.consult_desc | default: 'Our Architecture Consultation service helps you create an efficient kitchen workflow, maximize space, and ensure compliance before you invest.' }}</p>
          <div class="jv-consult__feats">
            {%- assign feats = section.blocks | where: 'type', 'consult_feature' -%}
            {%- if feats.size > 0 -%}
              {%- for f in feats -%}
                <div class="jv-consult__feat" {{ f.shopify_attributes }}>
                  <i>{%- render 'jv-icon', icon: f.settings.icon -%}</i>
                  <span>{{ f.settings.label }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
          <div style="display:flex;align-items:center;flex-wrap:wrap;">
            {%- if section.settings.consult_cta_text != blank -%}
              <a href="{{ section.settings.consult_cta_url | default: '#' }}" class="jv-btn jv-btn--primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                {{ section.settings.consult_cta_text }}
              </a>
            {%- endif -%}
            {%- if section.settings.consult_note != blank -%}
              <span class="jv-consult__note">{{ section.settings.consult_note }}</span>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ================= 4. FINAL CTA ================= {%- endcomment -%}
  {%- if section.settings.show_final -%}
    <section class="jv-final">
      <div class="jv-wrap">
        <div class="jv-final__grid">
          <div class="jv-final__body jv-rise">
            <span class="jv-eyebrow">{{ section.settings.final_eyebrow | default: 'Your Story Starts Here' }}</span>
            <h2 class="jv-final__title">{{ section.settings.final_title_1 | default: "Let's Build Your Restaurant" }} <span class="c">{{ section.settings.final_hl | default: 'Success Story' }}</span></h2>
            <p class="jv-final__text">{{ section.settings.final_text | default: "From the first sketch to your grand opening and beyond, we're with you every step of the way." }}</p>
            {%- if section.settings.final_cta_text != blank -%}
              <a href="{{ section.settings.final_cta_url | default: '#' }}" class="jv-btn jv-btn--primary">
                {{ section.settings.final_cta_text }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>
          <div class="jv-final__gallery jv-rise">
            {%- assign gcards = section.blocks | where: 'type', 'gallery' -%}
            {%- for g in gcards -%}
              {%- assign g_url = '' -%}
              {%- if g.settings.image -%}
                {%- assign g_url = g.settings.image | image_url: width: 640 -%}
              {%- elsif g.settings.image_asset != blank -%}
                {%- assign g_url = g.settings.image_asset | asset_url -%}
              {%- endif -%}
              <div class="jv-gcard" {{ g.shopify_attributes }}>
                <div class="jv-gcard__img">
                  {%- if g_url != blank -%}<img src="{{ g_url }}" alt="{{ g.settings.label | escape }}" loading="lazy" width="640" height="640">{%- endif -%}
                </div>
                <div class="jv-gcard__badge">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
                <div class="jv-gcard__label">{{ g.settings.label }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function() {
    var root = document.getElementById('jv2-{{ section.id }}');
    if (!root) return;

    /* ---- Scroll reveal ---- */
    var rises = root.querySelectorAll('.jv-rise');
    if ('IntersectionObserver' in window) {
      var ro = new IntersectionObserver(function(es) {
        es.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('is-in'); ro.unobserve(e.target); } });
      }, { threshold: 0.12 });
      rises.forEach(function(el) { ro.observe(el); });
    } else { rises.forEach(function(el) { el.classList.add('is-in'); }); }

    /* ---- Interactive stepper ---- */
    var stepper = root.querySelector('[data-stepper]');
    if (!stepper) return;
    var count = parseInt(stepper.getAttribute('data-count'), 10);
    var navBtns = stepper.querySelectorAll('[data-nav]');
    var panes = stepper.querySelectorAll('[data-pane]');
    var fill = stepper.querySelector('[data-nav-fill]');
    var curEl = root.querySelector('[data-cur]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var idx = 0;

    function pad(n) { return (n < 10 ? '0' : '') + n; }

    function show(i) {
      idx = Math.max(0, Math.min(count - 1, i));
      navBtns.forEach(function(b, n) {
        b.classList.toggle('is-active', n === idx);
        b.classList.toggle('is-done', n < idx);
        b.setAttribute('aria-selected', n === idx ? 'true' : 'false');
      });
      panes.forEach(function(p, n) { p.classList.toggle('is-active', n === idx); });
      if (fill) fill.style.height = (count > 1 ? (idx / (count - 1)) * 100 : 0) + '%';
      if (curEl) curEl.textContent = pad(idx + 1);
      if (prev) prev.disabled = idx === 0;
      if (next) next.disabled = idx === count - 1;
    }

    navBtns.forEach(function(b, n) { b.addEventListener('click', function() { show(n); }); });
    if (prev) prev.addEventListener('click', function() { show(idx - 1); });
    if (next) next.addEventListener('click', function() { show(idx + 1); });
    show(0);
  })();
</script>

{% schema %}
{
  "name": "Service Journey V2",
  "tag": "section",
  "class": "sj-v2-wrapper",
  "settings": [
    { "type": "header", "content": "Brand Colours" },
    { "type": "color", "id": "navy", "label": "Navy (primary)", "default": "#1A365D" },
    { "type": "color", "id": "coral", "label": "Coral (accent)", "default": "#FF5B5B" },

    { "type": "header", "content": "1 · Hero" },
    { "type": "checkbox", "id": "show_hero", "label": "Show hero", "default": true },
    { "type": "image_picker", "id": "hero_image", "label": "Hero banner image (contained on navy, right aligned)", "info": "Leave empty to use packaged journey-v2-hero.jpg" },
    { "type": "text", "id": "hero_pill", "label": "Tagline pill", "default": "Restaurant Equipment & Turnkey Solutions" },
    { "type": "text", "id": "hero_title_1", "label": "Title — part 1", "default": "Your Partner From" },
    { "type": "text", "id": "hero_hl_1", "label": "Title — highlight 1 (coral)", "default": "Design" },
    { "type": "text", "id": "hero_title_2", "label": "Title — part 2", "default": "to" },
    { "type": "text", "id": "hero_hl_2", "label": "Title — highlight 2 (gold)", "default": "Grand Opening" },
    { "type": "textarea", "id": "hero_sub", "label": "Subtitle", "default": "We handle every step so you can focus on your vision. From planning and design to equipment, installation and beyond — we make it happen." },
    { "type": "text", "id": "hero_cta_text", "label": "CTA text", "default": "Start Your Journey" },
    { "type": "url", "id": "hero_cta_url", "label": "CTA link" },
    { "type": "text", "id": "hero_trust_text", "label": "Trust text", "default": "1000+ Restaurants Trust Us" },
    { "type": "image_picker", "id": "hero_avatar_1", "label": "Trust avatar 1" },
    { "type": "image_picker", "id": "hero_avatar_2", "label": "Trust avatar 2" },
    { "type": "image_picker", "id": "hero_avatar_3", "label": "Trust avatar 3" },
    { "type": "checkbox", "id": "show_hero_steps", "label": "Show step chips row", "default": true },
    { "type": "text", "id": "hero_steps", "label": "Step chips (comma separated, 'NN Label')", "default": "01 Design,02 Plan,03 Equip,04 Build,05 Open" },

    { "type": "header", "content": "2 · Process" },
    { "type": "checkbox", "id": "show_process", "label": "Show process stepper", "default": true },
    { "type": "text", "id": "proc_eyebrow", "label": "Eyebrow", "default": "The Journey" },
    { "type": "text", "id": "proc_title", "label": "Title", "default": "7 Steps to Your Successful Restaurant" },
    { "type": "textarea", "id": "proc_sub", "label": "Subtitle", "default": "A proven process that turns your vision into a thriving restaurant." },

    { "type": "header", "content": "3 · Architecture Consultation" },
    { "type": "checkbox", "id": "show_consult", "label": "Show section", "default": true },
    { "type": "image_picker", "id": "consult_image", "label": "Blueprint image (contained on navy)", "info": "Leave empty to use packaged journey-v2-blueprint.jpg" },
    { "type": "text", "id": "consult_eyebrow", "label": "Eyebrow", "default": "Expert Guidance" },
    { "type": "text", "id": "consult_title_1", "label": "Title — part 1", "default": "Need Help" },
    { "type": "text", "id": "consult_hl", "label": "Title — highlight (coral)", "default": "Designing" },
    { "type": "text", "id": "consult_title_2", "label": "Title — part 2", "default": "Your Restaurant?" },
    { "type": "textarea", "id": "consult_desc", "label": "Description", "default": "Our Architecture Consultation service helps you create an efficient kitchen workflow, maximize space, and ensure compliance before you invest." },
    { "type": "text", "id": "consult_cta_text", "label": "CTA text", "default": "Book a Free Consultation" },
    { "type": "url", "id": "consult_cta_url", "label": "CTA link" },
    { "type": "text", "id": "consult_note", "label": "CTA note", "default": "No Obligation. Just Expert Advice." },

    { "type": "header", "content": "4 · Final CTA" },
    { "type": "checkbox", "id": "show_final", "label": "Show section", "default": true },
    { "type": "text", "id": "final_eyebrow", "label": "Eyebrow", "default": "Your Story Starts Here" },
    { "type": "text", "id": "final_title_1", "label": "Title — part 1", "default": "Let's Build Your Restaurant" },
    { "type": "text", "id": "final_hl", "label": "Title — highlight (coral)", "default": "Success Story" },
    { "type": "textarea", "id": "final_text", "label": "Text", "default": "From the first sketch to your grand opening and beyond, we're with you every step of the way." },
    { "type": "text", "id": "final_cta_text", "label": "CTA text", "default": "Start Your Journey Today" },
    { "type": "url", "id": "final_cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        { "type": "text", "id": "nav_label", "label": "Nav label (short)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step Title" },
        { "type": "text", "id": "tagline", "label": "Tagline (small caps)" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "bullets", "label": "Bullet points (comma separated)" },
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "text", "id": "image_asset", "label": "Fallback asset filename", "info": "e.g. journey-v2-step-1-planning.jpg (used if no image picked)" }
      ]
    },
    {
      "type": "consult_feature",
      "name": "Consultation Feature",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Kitchen Workflow Design" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "flow",
          "options": [
            { "value": "flow", "label": "Workflow" },
            { "value": "grid", "label": "Planning" },
            { "value": "expand", "label": "Space" },
            { "value": "shield", "label": "Compliance" }
          ] }
      ]
    },
    {
      "type": "gallery",
      "name": "Final CTA Image",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Design" },
        { "type": "image_picker", "id": "image", "label": "Image (1:1)" },
        { "type": "text", "id": "image_asset", "label": "Fallback asset filename", "info": "e.g. journey-v2-cta-1-design.jpg" }
      ]
    }
  ],
  "presets": [ { "name": "Service Journey V2" } ]
}
{% endschema %}
